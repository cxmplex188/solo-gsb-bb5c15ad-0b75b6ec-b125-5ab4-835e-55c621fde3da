{
  "name": "clause-reference-validator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "条款引用校验台 — 本地运行的中文条款编号与交叉引用校验工具",
  "scripts": {
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "build:client": "tsc --noEmit && vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --outfile=dist-server/index.mjs --external:express",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist-server/index.mjs",
    "preview": "npm run build && npm start",
    "check": "tsx scripts/check.ts"
  },
  "dependencies": {
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "esbuild": "^0.23.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0"
  }
}
